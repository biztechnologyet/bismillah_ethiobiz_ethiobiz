{
    "name": "EthioBiz Company Membership",
    "module": "EthioBiz Theme",
    "custom": 1,
    "docstatus": 0,
    "doctype": "DocType",
    "autoname": "format:ECM-{YYYY}-{#####}",
    "fields": [
        {
            "fieldname": "user",
            "fieldtype": "Link",
            "label": "Master User",
            "options": "User",
            "reqd": 1,
            "in_list_view": 1,
            "search_index": 1
        },
        {
            "fieldname": "company",
            "fieldtype": "Link",
            "label": "Company",
            "options": "Company",
            "reqd": 1,
            "in_list_view": 1,
            "search_index": 1
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Active\nInvited\nSuspended\nRevoked",
            "default": "Active",
            "in_list_view": 1
        },
        {
            "fieldname": "is_default",
            "fieldtype": "Check",
            "label": "Default Company",
            "default": 0,
            "in_list_view": 1
        },
        {
            "fieldname": "role_profile",
            "fieldtype": "Link",
            "label": "Role Profile",
            "options": "Role Profile"
        },
        {
            "fieldname": "roles",
            "fieldtype": "Small Text",
            "label": "Role Snapshot (comma separated)",
            "description": "Informational snapshot used by the switcher/audit. Actual access is enforced through Company User Permissions and the user's role profile."
        },
        {
            "fieldname": "invited_by",
            "fieldtype": "Link",
            "label": "Invited By",
            "options": "User"
        },
        {
            "fieldname": "joined_on",
            "fieldtype": "Datetime",
            "label": "Joined On"
        },
        {
            "fieldname": "notes",
            "fieldtype": "Small Text",
            "label": "Notes"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "report": 1,
            "export": 1,
            "share": 1,
            "print": 1,
            "email": 1
        }
    ],
    "sort_field": "modified",
    "sort_order": "DESC",
    "track_changes": 1
}
